{
  "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
  "version": 2,
  "settings": {
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "color": {
      "palette": [
        {
          "color": "#1a1448",
          "name": "Primary Dark Purple",
          "slug": "primary-dark"
        },
        {
          "color": "#e19a58",
          "name": "Accent Warm Orange",
          "slug": "accent-orange"
        },
        {
          "color": "#cad1e9",
          "name": "Light Blue Gray",
          "slug": "light-blue-gray"
        },
        {
          "color": "#ffffff",
          "name": "White",
          "slug": "white"
        },
        {
          "color": "#f5f5f7",
          "name": "Light Gray Background",
          "slug": "light-gray"
        },
        {
          "color": "#f4f6f7",
          "name": "Soft Gray",
          "slug": "soft-gray"
        },
        {
          "color": "#404040",
          "name": "Text Primary",
          "slug": "text-primary"
        },
        {
          "color": "#8c8c8c",
          "name": "Text Secondary",
          "slug": "text-secondary"
        },
        {
          "color": "rgba(255, 255, 255, 0.85)",
          "name": "White Translucent",
          "slug": "white-translucent"
        },
        {
          "color": "rgba(255, 255, 255, 0.1)",
          "name": "White Subtle",
          "slug": "white-subtle"
        }
      ],
      "gradients": [
        {
          "gradient": "linear-gradient(135deg, #1a1448 0%, #2a2468 100%)",
          "name": "Primary Purple Gradient",
          "slug": "primary-gradient"
        },
        {
          "gradient": "linear-gradient(135deg, #e19a58 0%, #f0b070 100%)",
          "name": "Accent Orange Gradient",
          "slug": "accent-gradient"
        },
        {
          "gradient": "linear-gradient(135deg, #1a1448 0%, #e19a58 100%)",
          "name": "Purple to Orange Gradient",
          "slug": "primary-to-accent"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif",
          "name": "System Font",
          "slug": "system-font"
        },
        {
          "fontFamily": "\"Fira Sans\", sans-serif",
          "name": "Fira Sans",
          "slug": "fira-sans"
        },
        {
          "fontFamily": "\"Platypi\", serif",
          "name": "Platypi",
          "slug": "platypi"
        },
        {
          "fontFamily": "\"Fira Code\", monospace",
          "name": "Fira Code",
          "slug": "fira-code"
        }
      ],
      "fontSizes": [
        {
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "size": "1rem",
          "slug": "base"
        },
        {
          "size": "1.125rem",
          "slug": "medium"
        },
        {
          "size": "1.5rem",
          "slug": "large"
        },
        {
          "size": "2rem",
          "slug": "x-large"
        },
        {
          "size": "2.5rem",
          "slug": "xx-large"
        },
        {
          "size": "3.5rem",
          "slug": "xxx-large"
        }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "spacingSizes": [
        {
          "size": "0",
          "slug": "0"
        },
        {
          "size": "0.25rem",
          "slug": "1"
        },
        {
          "size": "0.5rem",
          "slug": "2"
        },
        {
          "size": "0.75rem",
          "slug": "3"
        },
        {
          "size": "1rem",
          "slug": "4"
        },
        {
          "size": "1.5rem",
          "slug": "5"
        },
        {
          "size": "2rem",
          "slug": "6"
        },
        {
          "size": "2.5rem",
          "slug": "7"
        },
        {
          "size": "3rem",
          "slug": "8"
        },
        {
          "size": "4rem",
          "slug": "9"
        },
        {
          "size": "5rem",
          "slug": "10"
        }
      ]
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        }
      },
      "core/navigation": {
        "typography": {
          "fontSizes": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "var(--wp--preset--color--text-primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--fira-sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary-dark)",
          ":hover": {
            "text": "var(--wp--preset--color--accent-orange)"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--primary-dark)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--platypi)",
          "fontWeight": "600"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xxx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": "var(--wp--preset--color--accent-orange)",
          "text": "var(--wp--preset--color--white)"
        },
        "typography": {
          "fontWeight": "600"
        },
        "border": {
          "radius": "8px"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)"
          }
        }
      },
      "core/cover": {
        "color": {
          "background": "var(--wp--preset--color--primary-dark)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      }
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    }
  ]
}
