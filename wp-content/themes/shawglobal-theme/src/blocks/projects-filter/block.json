{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shawglobal/projects-filter",
	"version": "1.0.0",
	"title": "Immigration Projects Filter",
	"category": "widgets",
	"icon": "filter",
	"description": "Filter and display immigration projects with AJAX",
	"keywords": ["immigration", "filter", "ajax", "projects"],
	"textdomain": "shawglobal-theme",
	"attributes": {
		"columns": {
			"type": "number",
			"default": 3
		},
		"postsPerPage": {
			"type": "number",
			"default": 12
		}
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css"
}
